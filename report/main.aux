\@writefile{toc}{\contentsline {subsection}{\numberline {8.4}Class Diagrams}{18}{subsection.8.4}\protected@file@percent }
\newlabel{section:app:diagrams}{{8.4}{18}{Class Diagrams}{subsection.8.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces System composition overview. The user-facing \texttt  {HMM} class owns an \texttt  {HMMParams} instance composed of a \texttt  {BaseTransition} and a \texttt  {BaseEmission}. Fitting is delegated to a \texttt  {BaseSolver} subclass and state inference is handled by \texttt  {ForwardAlgorithm}, producing \texttt  {HMMResults} and \texttt  {StateResults}.}}{18}{figure.caption.15}\protected@file@percent }
\newlabel{fig:diagram:composition}{{5}{18}{System composition overview. The user-facing \texttt {HMM} class owns an \texttt {HMMParams} instance composed of a \texttt {BaseTransition} and a \texttt {BaseEmission}. Fitting is delegated to a \texttt {BaseSolver} subclass and state inference is handled by \texttt {ForwardAlgorithm}, producing \texttt {HMMResults} and \texttt {StateResults}}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Emission class hierarchy. \texttt  {GaussEmission} models state-dependent Gaussian distributions with monotonically ordered means enforced via cumulative exponentiation of \texttt  {log\_mu\_diff}. \texttt  {AutoregressiveGaussEmission} extends this with AR($p$) dynamics, where coefficients are stored unconstrained (\texttt  {phi\_tilde}) and mapped to $(-1, 1)$ via $\tanh $ to guarantee stationarity.}}{18}{figure.caption.16}\protected@file@percent }
\newlabel{fig:diagram:emissions}{{6}{18}{Emission class hierarchy. \texttt {GaussEmission} models state-dependent Gaussian distributions with monotonically ordered means enforced via cumulative exponentiation of \texttt {log\_mu\_diff}. \texttt {AutoregressiveGaussEmission} extends this with AR($p$) dynamics, where coefficients are stored unconstrained (\texttt {phi\_tilde}) and mapped to $(-1, 1)$ via $\tanh $ to guarantee stationarity}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Transition class hierarchy. Both implementations store parameters as logits and convert them to a row-stochastic matrix via row-wise softmax. \texttt  {StaticTransition} uses a constant $K \times K$ matrix, while \texttt  {StaticTransitionHigherOrder} augments the state space to $K^{\text  {order}}$ states to represent a higher-order Markov chain.}}{19}{figure.caption.17}\protected@file@percent }
\newlabel{fig:diagram:transitions}{{7}{19}{Transition class hierarchy. Both implementations store parameters as logits and convert them to a row-stochastic matrix via row-wise softmax. \texttt {StaticTransition} uses a constant $K \times K$ matrix, while \texttt {StaticTransitionHigherOrder} augments the state space to $K^{\text {order}}$ states to represent a higher-order Markov chain}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Inference and output class hierarchy. \texttt  {BaseInference.run()} iterates \texttt  {step()} across the time axis using \texttt  {jax.lax.scan}. \texttt  {ForwardAlgorithm} implements the forward filtering pass and produces a \texttt  {ForwardOutput} storing the scaling factors $f_t$, filtered state probabilities $u_{t|t}$, and predicted state probabilities $u_t$. The log-likelihood is computed as $\DOTSB \sum@ \slimits@ _t \log f_t$.}}{19}{figure.caption.18}\protected@file@percent }
\newlabel{fig:diagram:inference}{{8}{19}{Inference and output class hierarchy. \texttt {BaseInference.run()} iterates \texttt {step()} across the time axis using \texttt {jax.lax.scan}. \texttt {ForwardAlgorithm} implements the forward filtering pass and produces a \texttt {ForwardOutput} storing the scaling factors $f_t$, filtered state probabilities $u_{t|t}$, and predicted state probabilities $u_t$. The log-likelihood is computed as $\sum _t \log f_t$}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Solver class hierarchy. \texttt  {BaseSolver} partitions parameters into trainable and frozen subsets and wraps the negative log-likelihood as the loss function. The three concrete solvers share the same interface but differ in their optimization backend: \texttt  {GradientSolver} uses first-order gradient descent via \texttt  {optax}, \texttt  {LBFGSSolver} uses quasi-Newton L-BFGS via \texttt  {optax}, and \texttt  {Minimizer} wraps \texttt  {jax.scipy.optimize.minimize}.}}{20}{figure.caption.19}\protected@file@percent }
\newlabel{fig:diagram:solvers}{{9}{20}{Solver class hierarchy. \texttt {BaseSolver} partitions parameters into trainable and frozen subsets and wraps the negative log-likelihood as the loss function. The three concrete solvers share the same interface but differ in their optimization backend: \texttt {GradientSolver} uses first-order gradient descent via \texttt {optax}, \texttt {LBFGSSolver} uses quasi-Newton L-BFGS via \texttt {optax}, and \texttt {Minimizer} wraps \texttt {jax.scipy.optimize.minimize}}{figure.caption.19}{}}
